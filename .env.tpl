# None of these is a secret: Firebase's web config is public, and the browser
# ships it. Copy this file to .env.local and fill the key and the app id from
# the Vercel project's variables. Leave the auth domain empty on a dev server,
# where it falls back to the page's own host through the proxy in
# vite.config.ts.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=tideline-ibuild4you
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
